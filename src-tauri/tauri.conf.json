{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProjectPane",
  "version": "1.2.1",
  "identifier": "com.swallowkim.projectpane",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "features": [
      "desktop"
    ]
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "ProjectPane",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560,
        "dragDropEnabled": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "license": "MIT",
    "copyright": "Copyright (c) 2026 swallow-kim",
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/projectpane-read-worker"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean",
          "English"
        ],
        "template": "installer/template.nsi",
        "installerHooks": "installer/safety.nsh"
      }
    }
  }
}
