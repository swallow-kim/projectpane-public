{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProjectPane",
  "version": "1.5.2",
  "identifier": "com.swallowkim.projectpane",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "features": [
      "desktop"
    ]
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "ProjectPane",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560,
        "dragDropEnabled": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "license": "MIT",
    "copyright": "Copyright (c) 2026 swallow-kim",
    "active": true,
    "resources": {
      "../LICENSE": "licenses/LICENSE",
      "../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md",
      "../docs/dependency-licenses-1.5.2.md": "licenses/docs/dependency-licenses-1.5.2.md",
      "../docs/third-party-license-texts.md": "licenses/docs/third-party-license-texts.md",
      "../docs/lucide-license.txt": "licenses/docs/lucide-license.txt",
      "../docs/licenses/": "licenses/docs/licenses/",
      "installer/LICENSE-MIT": "licenses/src-tauri/installer/LICENSE-MIT"
    },
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean",
          "English"
        ],
        "template": "installer/template.nsi",
        "installerHooks": "installer/safety.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIzNDUxQUQ1RThFN0FDQjIKUldTeXJPZm8xUnBGczQzbVIycjlZcXZ1WHIwUzF3aHdtd3YvdmlYRm9BT0EyL3hLa2V5QTd6cU4K",
      "requireSignedVersion": true,
      "allowDowngrades": false,
      "endpoints": [
        "https://github.com/swallow-kim/projectpane-public/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
