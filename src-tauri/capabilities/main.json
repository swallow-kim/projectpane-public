{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Only narrow application commands for the local main window.",
  "local": true,
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-list-archive-tools",
    "allow-launch-archive-tool",
    "allow-startup-config",
    "allow-poll-watch",
    "allow-start-listing",
    "allow-read-listing",
    "allow-cancel-listing",
    "allow-set-listing-view",
    "allow-locate-entry",
    "allow-activate-entry",
    "allow-export-to-explorer",
    "allow-import-from-explorer",
    "allow-clipboard-sequence",
    "allow-list-projects",
    "allow-list-favorites",
    "allow-save-favorites",
    "allow-create-project",
    "allow-load-project",
    "allow-rename-project",
    "allow-duplicate-project",
    "allow-remove-project",
    "allow-save-project-preset",
    "allow-save-project-session",
    "allow-project-close-ready",
    "allow-get-operation-state",
    "allow-prepare-operation",
    "allow-capture-transfer",
    "allow-prepare-transfer",
    "allow-execute-operation",
    "allow-cancel-operation",
    "allow-discard-operation",
    "allow-get-operation-report",
    "allow-forget-operation",
    "allow-operation-close-choice",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
