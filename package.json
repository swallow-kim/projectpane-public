{
  "name": "projectpane",
  "version": "1.4.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test scripts/test-summarize-local-memory.mjs scripts/test-security.mjs scripts/test-windows-evidence-sanitize.mjs",
    "test:browser": "playwright test",
    "tauri": "tauri",
    "prepare:worker": "node scripts/prepare-worker.mjs",
    "desktop:dev": "npm run prepare:worker && tauri dev",
    "desktop:build": "npm run prepare:worker -- --release && tauri build --bundles nsis"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.1",
    "lucide-react": "1.61.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
